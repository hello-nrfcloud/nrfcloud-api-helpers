{
  "name": "@hello.nrfcloud.com/nrfcloud-api-helpers",
  "version": "0.0.0-development",
  "description": "Helper functions for integrating nRF Cloud APIs in AWS lambdas written in TypeScript.",
  "exports": {
    "./*": {
      "import": {
        "types": "./dist/*/export.d.ts",
        "default": "./dist/*/export.js"
      }
    }
  },
  "type": "module",
  "scripts": {
    "test": "node --no-warnings --experimental-transform-types --test \"!(node_modules|e2e-tests|integration-tests)/**/*.spec.ts\"",
    "prepare": "husky && case \"$npm_command\" in install|ci) check-node-version --package ;; esac",
    "prepublishOnly": "npx tsc --noEmit false -d"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hello-nrfcloud/nrfcloud-api-helpers.git"
  },
  "bugs": {
    "url": "https://github.com/hello-nrfcloud/nrfcloud-api-helpers/issues"
  },
  "homepage": "https://github.com/hello-nrfcloud/nrfcloud-api-helpers",
  "keywords": [
    "aws",
    "lambda",
    "typescript"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@bifravst/eslint-config-typescript": "8.0.1",
    "@bifravst/prettier-config": "2.0.0",
    "@commitlint/config-conventional": "21.2.2",
    "@types/aws-lambda": "8.10.162",
    "@types/node": "26.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "check-node-version": "4.2.1",
    "commitlint": "21.2.2",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint"
    ],
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "prettier": "@bifravst/prettier-config",
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": ">=3.1111.0 <4",
    "@aws-sdk/client-ssm": ">=3.1111.0 <4",
    "@aws-sdk/util-dynamodb": ">=3.996.9 <4",
    "@bifravst/aws-ssm-settings-helpers": ">=2.0.1 <3",
    "@hello.nrfcloud.com/proto": "16.x",
    "@sinclair/typebox": "^0.34.52"
  }
}
